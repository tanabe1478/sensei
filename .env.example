# 必須
DISCORD_TOKEN=your-discord-bot-token
DISCORD_ALLOWED_USER=your-discord-user-id
# Codex 認証: `codex login` で OAuth 認証済みなら不要
# OPENAI_API_KEY=your-openai-api-key

# オプション
# AUTO_REPLY_CHANNELS=channel-id-1,channel-id-2
# AGENT_MODEL=o4-mini
# TIMEOUT_MS=300000
# CODEX_SANDBOX=read-only
# WORKSPACE_PATH=/path/to/workspace
# SCHEDULER_ENABLED=true
# DATA_DIR=/path/to/data
# LEARNING_WORKSPACE_PATH=/path/to/learning/workspace
# DEFAULT_PROJECT=default
# REVIEW_NOTIFY_CHANNEL=channel-id
